# Copy to provisioning.env, fill in the local values, and run:
#   chmod 600 provisioning.env
#
# provisioning.env is ignored by Git. It is used only to render DietPi's
# first-boot files and is never copied to the Pi under this name.

WIFI_SSID='LEXACUBE'
WIFI_PASSWORD='replace-me'
# Optional cube-only network. This is compiled into ESP32 firmware but is
# never added to the Pi's WiFi profiles, so the Pi remains on WIFI_SSID.
CUBE_WIFI_SSID=''
CUBE_WIFI_PASSWORD=''
WIFI_COUNTRY='US'

DIETPI_PASSWORD='replace-with-a-unique-password'
DIETPI_HOSTNAME='lexacube'
DIETPI_TIMEZONE='America/Los_Angeles'
# DietPi's image default is `gb`; set this to match the physical keyboard
# attached during first-boot recovery (e.g. `us`, `gb`, `de`).
DIETPI_KEYBOARD_LAYOUT='us'

# Optional. When present, password-based SSH login is disabled.
SSH_PUBLIC_KEY_FILE='~/.ssh/id_ed25519.pub'

# Optional. Staged on the boot partition, then installed by bootstrap.sh as
# ~/.claude-switch/zai-key (0600) and deleted from /boot. Without it the
# claude-zai alias warns and does nothing. Leave empty to skip.
ZAI_API_KEY=''

# Optional. Directory on this Mac holding per-rig application secrets as
# `<app>.env` (e.g. lexacube.env, knockstrip.env). Every *.env file found here
# is staged on the boot partition, and bootstrap.sh installs it to /etc/<app>.env
# (0600) and deletes the boot copy. Without them lexacube records no analytics
# and knockstrip will not start. Default: ~/.lexacube-secrets
SECRETS_DIR='~/.lexacube-secrets'
