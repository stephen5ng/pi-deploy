# Copy to provisioning.env, fill in the local values, and run:
#   chmod 600 provisioning.env
#
# provisioning.env is ignored by Git. It is used only to render DietPi's
# first-boot files and is never copied to the Pi under this name.

WIFI_SSID='LEXACUBE'
WIFI_PASSWORD='replace-me'
WIFI_COUNTRY='US'

DIETPI_PASSWORD='replace-with-a-unique-password'
DIETPI_HOSTNAME='lexacube'
DIETPI_TIMEZONE='America/Los_Angeles'

# Optional. When present, password-based SSH login is disabled.
SSH_PUBLIC_KEY_FILE='~/.ssh/id_ed25519.pub'

# --- knockstrip service secrets --------------------------------------------
# Provisioned to the Pi's /etc/knockstrip.env (mode 0600) over ssh, AFTER the
# Pi is up, by:  python3 scripts/provision_knockstrip_env.py
# These are NOT rendered onto the SD card. Leave any value blank to skip it.

# ssh target for that script (default dietpi@192.168.8.247). Override per-run
# with --pi or the KNOCKSTRIP_PI_HOST env var.
KNOCKSTRIP_PI_HOST=''

# PostHog analytics. Preferred: give the phx_ personal key and the script fetches
# the phc_ project ingest key from the PostHog API (only the public phc_ reaches
# the Pi). Or set POSTHOG_API_KEY=phc_... directly to skip the fetch.
POSTHOG_PERSONAL_API_KEY=''
POSTHOG_API_KEY=''
# Optional overrides (defaults: 507032 / https://us.posthog.com).
POSTHOG_PROJECT=''
POSTHOG_HOST_MGMT=''

# Pursuit clue-grant API key (presented to /api/v1/clues/status).
CLUE_STATUS_API_KEY=''

# Pusher app secret (signs the phone/preview channel auth).
PUSHER_SECRET=''
